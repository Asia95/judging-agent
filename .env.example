# .env.example — copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── IBM watsonx.ai credentials (required) ─────────────────────────────────────
WATSONX_API_KEY=your-ibm-cloud-api-key-here
WATSONX_PROJECT_ID=your-watsonx-project-id-here
# Service URL — use the region closest to you:
#   Dallas  : https://us-south.ml.cloud.ibm.com
#   Frankfurt: https://eu-de.ml.cloud.ibm.com
#   London  : https://eu-gb.ml.cloud.ibm.com
#   Tokyo   : https://jp-tok.ml.cloud.ibm.com
#   Sydney  : https://au-syd.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Model IDs (optional — defaults shown) ─────────────────────────────────────
# Worker agent model: third-party model hosted on watsonx.ai
WORKER_MODEL_ID=openai/gpt-oss-120b

# Guardian model: derives the task scope and judges medium/high-risk calls.
# Default: meta-llama/llama-3-3-70b-instruct (scored better than
# ibm/granite-4-h-small on every eval; see README).
GUARDIAN_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# ── Audit log path (optional) ─────────────────────────────────────────────────
# JSON Lines audit log for apps/run_task.py, one record per tool call.
# The evals always write to their own files in runs/.
AUDIT_LOG_PATH=runs/audit.jsonl

# ── Workspace boundary (optional) ─────────────────────────────────────────────
# Folder ID the agent is confined to: anything outside it is blocked by a fixed
# rule. Leave empty to allow the whole Drive.
WORKSPACE_FOLDER_ID=
